# Irrigatalizer deployment configuration.
#
# Copy this file to `infra/config.env` and edit for your Pi. `config.env` is
# git-ignored so your host details and any secrets never get committed.
#
#   cp infra/config.env.example infra/config.env
#
# All three scripts (provision.sh, package.sh, deploy.sh) source this file.

# --- SSH connection to the Pi ---------------------------------------------

# Hostname or IP of the Pi as reached over SSH. This is the admin login you use
# to set the machine up; it does NOT have to be the service account.
PI_HOST="raspberrypi.local"

# The login user for SSH. On a fresh Raspberry Pi OS install this is whatever
# account you created in Raspberry Pi Imager (commonly "pi"). It needs sudo.
PI_USER="pi"

# SSH port (default 22).
PI_SSH_PORT="22"

# Optional path to a private key for SSH. Leave empty to use your ssh-agent /
# default keys. Example: "$HOME/.ssh/irrigatalizer_ed25519"
PI_SSH_KEY=""

# --- Service account and install locations on the Pi ----------------------

# The unprivileged account the controller runs as. provision.sh creates it if
# missing and adds it to the `gpio` group so it can drive /dev/gpiochip0.
# Keeping the service separate from your login account is good hygiene, but you
# may set this to PI_USER if you prefer a single account.
SERVICE_USER="irrigatalizer"

# Absolute directory on the Pi where the built application is installed. Owned
# by SERVICE_USER. The release tarball is extracted here on each deploy.
APP_DIR="/opt/irrigatalizer"

# Data directory for the JSON config + history. The server defaults to
# ~/.irrigatalizer of the running user; this is passed through so it is explicit
# and survives redeploys. Owned by SERVICE_USER.
DATA_DIR="/var/lib/irrigatalizer"

# --- Runtime -------------------------------------------------------------

# Port the Node process listens on. provision.sh sets up an iptables redirect so
# port 80 reaches this port without the app needing root.
APP_PORT="9000"

# Node major version to install on the Pi (via NodeSource). 24 matches the
# server build target (tsup target node24).
NODE_MAJOR="24"

# GPIO driver: leave empty for the real libgpiod CLI driver (production). Set to
# "fake" ONLY for a hardware-less smoke test — it will not switch real relays.
#   GPIO_DRIVER="fake"
GPIO_DRIVER=""
