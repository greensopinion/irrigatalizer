{
  "name": "irrigatalizer",
  "version": "1.0.0",
  "description": "Irrigation controller for a Raspberry Pi driving relay-operated valves.",
  "license": "Apache-2.0",
  "private": true,
  "author": {
    "name": "David Green",
    "email": "greensopinion@gmail.com",
    "url": "https://greensopinion.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/greensopinion/irrigatalizer.git"
  },
  "type": "module",
  "workspaces": [
    "server",
    "web-ui"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "build": "npm run build --workspaces",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "concurrently --kill-others --names \"server,web-ui\" --prefix-colors \"blue,magenta\" \"npm run dev --workspace=server\" \"npm run dev --workspace=web-ui\"",
    "dev:fake": "concurrently --kill-others --names \"server,web-ui\" --prefix-colors \"blue,magenta\" \"npm run dev:fake --workspace=server\" \"npm run dev --workspace=web-ui\"",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "concurrently": "10.0.5",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.27.2": true,
    "fsevents@2.3.3": true
  }
}
